GEMINI_API_KEY=your_api_key_here
PORT=3000

# Firebase Admin credentials (never expose these values in frontend code)
FIREBASE_PROJECT_ID=cliq-8dba8
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@example.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
FIREBASE_DATABASE_URL=https://cliq-8dba8-default-rtdb.firebaseio.com/

# Calendar day used for the daily AI limit
AI_USAGE_TIME_ZONE=Asia/Manila

# Prevents abandoned in-flight reservations from blocking future searches forever
AI_SEARCH_RESERVATION_TTL_MS=300000

# Maximum time to wait for an AI usage database operation
AI_DATABASE_TIMEOUT_MS=10000

# Temporary structured logs for reservation transaction diagnostics
AI_USAGE_DEBUG=false
